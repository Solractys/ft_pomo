{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ft-pomo-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "PomodoroRoom" }
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ft-pomo",
      "database_id": "replace-with-your-d1-database-id",
      "migrations_dir": "migrations"
    }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PomodoroRoom"] }
  ],
  "triggers": { "crons": ["17 4 * * *"] },
  "vars": { "APP_ORIGIN": "http://localhost:3000" }
}
